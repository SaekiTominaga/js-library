{
	"name": "js-library",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"lint": "eslint *.{js,mjs,ts}",
		"pretest": "npm run build --workspaces",
		"test": "node --experimental-test-coverage --experimental-strip-types --test packages/*/src/**/*.test.ts"
	},
	"devDependencies": {
		"@types/node": "24.10.0",
		"@w0s/eslint-config": "9.9.2",
		"@w0s/tsconfig": "3.0.0",
		"eslint": "9.39.5",
		"eslint-plugin-functional": "10.0.0",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsdoc": "64.2.1",
		"eslint-plugin-safely-storage": "1.1.0",
		"globals": "17.11.0",
		"oxfmt": "0.64.0",
		"rimraf": "6.1.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.67.0"
	}
}
